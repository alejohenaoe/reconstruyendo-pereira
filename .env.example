# Copia este archivo a .env y completa los valores.
# La publishable key de Supabase es pública (la seguridad real depende de Auth + RLS).
# NUNCA colocar una secret/service key en variables con prefijo VITE_.

# URL del proyecto remoto "reconstruyendo-pereira" (la local cambia con supabase start).
VITE_SUPABASE_URL=https://rpbpwwwvakpxzdinvojw.supabase.co

# Publicable/anon key. Local: supabase status -> anon key.
# Remoto: Settings -> API (anon key) del proyecto. Para Netlify se define
# en el dashboard por entorno (production / deploy-preview), no en el repo.
VITE_SUPABASE_PUBLISHABLE_KEY=
